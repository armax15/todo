# Production Environment Variables
# Скопируйте этот файл в .env.production и заполните реальными значениями

# NextAuth Configuration
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (получите на https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Provider (опционально)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@your-domain.com

# Backend API URL
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# Database (для docker-compose)
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=secure-password-here
POSTGRES_DB=taskmanager
DATABASE_URL=postgresql://taskmanager:secure-password-here@db:5432/taskmanager

# JWT Secret для Backend
JWT_SECRET=another-secure-secret-key
